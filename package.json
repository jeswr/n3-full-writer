{
  "name": "n3-full-writer",
  "version": "0.0.0-development",
  "description": "A complete, non-streaming N3 writer built on N3.js, with support for N3 formulas.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "license": "MIT",
  "author": "Jesse Wright",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeswr/n3-full-writer.git"
  },
  "bugs": {
    "url": "https://github.com/jeswr/n3-full-writer/issues"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "build": "tsc -p .",
    "prepack": "npm run build",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "lint": "tsc -p . --noEmit && tsc -p test/types && eslint ."
  },
  "dependencies": {
    "@rdfjs/types": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "jest": "30.4.2",
    "n3": "2.13.8",
    "rdf-isomorphic": "2.0.1",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.0"
  },
  "jest": {
    "testMatch": [
      "**/test/*-test.js"
    ],
    "transform": {
      "\\.ts$": "<rootDir>/test/transform-typescript.cjs"
    },
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/n3-internals.ts"
    ],
    "coverageProvider": "v8",
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "keywords": [
    "n3",
    "rdf",
    "notation3",
    "formula",
    "writer",
    "serializer"
  ],
  "homepage": "https://github.com/jeswr/n3-full-writer#readme",
  "peerDependencies": {
    "n3": ">=2.13.8 <2.14.0"
  }
}
